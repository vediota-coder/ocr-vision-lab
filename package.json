{
  "name": "ocr-vision-lab",
  "version": "0.1.0",
  "description": "OCR & vision experiments with Claude Vision and OpenAI Vision",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "ocr": "tsx src/index.ts",
    "server": "tsx src/server/index.ts",
    "server:dev": "tsx watch src/server/index.ts"
  },
  "keywords": [
    "ocr",
    "vision",
    "claude",
    "openai",
    "gpt",
    "anthropic"
  ],
  "author": "vediota",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^10.1.2",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.8.0",
    "fastify": "^5.8.5",
    "openai": "^4.77.0",
    "p-limit": "^7.3.0",
    "pdfkit": "^0.18.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
